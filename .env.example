# ---- Google (OAuth login for Gmail + Sheets) ----
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
SHEET_ID=your_sheet_id_here
SHEET_TAB=Sheet1

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ---- Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ---- Sender Identity (Optional if manual outreach) ----
SENDER_NAME=Your Name
SENDER_ADDRESS=Your City, Country
OFFER_LINE=We provide automated email workflows.

# ---- Sending & Polling Behaviour ----
DAILY_LIMIT=30
PER_RUN_LIMIT=8
POLL_MINUTES=20
WEEKDAYS_ONLY=false
DRY_RUN=false
